database -open waves -into waves.shm -default
probe -create -shm top_tb.dut.cs top_tb.dut.master_address top_tb.dut.master_in_data top_tb.dut.master_out_data top_tb.dut.master_rd_wr top_tb.dut.mclk top_tb.dut.miso top_tb.dut.mosi top_tb.dut.reset top_tb.dut.sclk top_tb.dut.slave_address top_tb.dut.slave_in_data top_tb.dut.slave_out_data top_tb.dut.slave_rd_wr top_tb.dut.start
run
coverage -analyze
